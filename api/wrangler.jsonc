{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onmyway-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onmyway",
      "database_id": "2e489ff3-7c39-4481-a04e-72533217a363",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_EMAIL_DOMAIN": "psu.edu",
    "CAMPUS_TIME_ZONE": "America/New_York",
    "DELIVERY_FEE_CENTS": "100",
    "PAYMENTS": "stripe",
    "APNS_TOPIC": "com.onmyway.app",
    "APNS_ENVIRONMENT": "sandbox"
  },
  // Secrets (wrangler secret put): STRIPE_SECRET_KEY, STRIPE_PUBLISHABLE_KEY, STRIPE_WEBHOOK_SECRET,
  // FCM_SERVICE_ACCOUNT, APNS_KEY, APNS_KEY_ID, APNS_TEAM_ID
  "triggers": {
    "crons": ["* * * * *"]
  }
}
